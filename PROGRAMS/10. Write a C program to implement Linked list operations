#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *next;
};

int main() {
    struct Node *head = NULL, *newNode, *temp;
    int choice, value;

    while (1) {
        printf("\n1.Insert  2.Delete  3.Display  4.Exit\n");
        scanf("%d", &choice);

        if (choice == 1) {
            newNode = (struct Node *)malloc(sizeof(struct Node));

            printf("Enter value: ");
            scanf("%d", &value);

            newNode->data = value;
            newNode->next = NULL;

            if (head == NULL)
                head = newNode;
            else {
                temp = head;
                while (temp->next != NULL)
                    temp = temp->next;
                temp->next = newNode;
            }
        }
        else if (choice == 2) {
            if (head == NULL)
                printf("List is empty\n");
            else {
                temp = head;
                head = head->next;
                free(temp);
            }
        }
        else if (choice == 3) {
            temp = head;
            while (temp != NULL) {
                printf("%d -> ", temp->data);
                temp = temp->next;
            }
            printf("NULL\n");
        }
        else
            break;
    }

    return 0;
}
